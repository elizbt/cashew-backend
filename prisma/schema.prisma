generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  chats     Chat[]

  @@map("users")
}

model Chat {
  id        String    @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  messages  Message[]
  user      User      @relation(fields: [userId], references: [id])

  @@map("chats")
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id])

  @@map("messages")
}

model UnansweredQuestion {
  id        String   @id @default(uuid())
  content   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@map("unanswered_questions")
}

model Department {
  id          String @id @default(uuid())
  name        String
  email       String
  phone       String
  description String

  @@map("departments")
}

model Document {
  id        String                 @id @default(uuid())
  content   String
  url       String?
  course    String?
  embedding Unsupported("vector(3072)")?
  createdAt DateTime               @default(now())

  @@map("documents")
}
