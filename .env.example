# Porta em que o servidor Fastify vai escutar
PORT=3333

# Ambiente de execução (development | production)
NODE_ENV=development

# String de conexão com o PostgreSQL (deve ter a extensão pgvector)
# Valores abaixo correspondem ao docker-compose.yml padrão do projeto
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/tcc_chat?schema=public"

# Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="SUA_CHAVE_AQUI"

# (Opcional) Modelos do Gemini usados pelo chat/RAG
# Se omitidos, o código usa os defaults abaixo
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Segredo usado para assinar os JWTs de autenticação
# IMPORTANTE: defina um valor forte e único em produção
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"

# Origens (separadas por vírgula) autorizadas a fazer requisições com
# credentials (cookie de sessão httpOnly). Sem isso definido, só origens
# localhost/127.0.0.1 (qualquer porta) são aceitas.
# Frontend e API precisam estar no mesmo site (ex.: app.dominio.com e
# api.dominio.com): os cookies de sessão são SameSite=Lax.
# OBRIGATÓRIO em produção — o boot falha sem essa variável quando
# NODE_ENV=production, já que "*" não é compatível com credentials: true.
# Exemplo: CORS_ORIGIN="https://app.seudominio.com,https://admin.seudominio.com"
CORS_ORIGIN=

# Número de proxies (TLS/load balancer/CDN) na frente do backend em produção.
# Ex.: só o proxy do PaaS = 1; Cloudflare + proxy do PaaS = 2. Errar para menos
# faz todos os usuários dividirem o mesmo limite de tentativas de login.
TRUST_PROXY_HOPS=1
