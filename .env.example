# Porta em que o servidor Fastify vai escutar
PORT=3333

# Ambiente de execução (development | production)
NODE_ENV=development

# String de conexão com o PostgreSQL (deve ter a extensão pgvector)
# Valores abaixo correspondem ao docker-compose.yml padrão do projeto
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/tcc_chat?schema=public"

# Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="SUA_CHAVE_AQUI"

# (Opcional) Modelos do Gemini usados pelo chat/RAG
# Se omitidos, o código usa os defaults abaixo
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Segredo usado para assinar os JWTs de autenticação
# IMPORTANTE: defina um valor forte e único em produção
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"
